set policy prefix-list OWN rule 10 prefix 198.18.101.0/24
set policy route-map FROM-CUSTOMER rule 10 action permit
set policy route-map FROM-CUSTOMER rule 10 match ip address prefix-list PUBLIC
set policy route-map FROM-CUSTOMER rule 10 set local-preference 200
set policy route-map FROM-CUSTOMER rule 10 set community replace 64501:1
set policy route-map FROM-PEER rule 10 action permit
set policy route-map FROM-PEER rule 10 match ip address prefix-list PUBLIC
set policy route-map FROM-PEER rule 10 set local-preference 150
set policy route-map FROM-PEER rule 10 set community replace 64501:2
set policy route-map FROM-PROVIDER rule 10 action permit
set policy route-map FROM-PROVIDER rule 10 match ip address prefix-list PUBLIC
set policy route-map FROM-PROVIDER rule 10 set local-preference 100
set policy route-map FROM-PROVIDER rule 10 set community replace 64501:3
set protocols bgp address-family ipv4-unicast network 198.18.101.0/24
set protocols static route 198.18.101.0/24 blackhole distance 250
set protocols bgp neighbor 198.18.0.9 remote-as 64496
set protocols bgp neighbor 198.18.0.9 description 'Continental Backbone, Denver'
set protocols bgp neighbor 198.18.0.9 timers keepalive 3
set protocols bgp neighbor 198.18.0.9 timers holdtime 9
set protocols bgp neighbor 198.18.0.9 timers connect 5
set protocols bgp neighbor 198.18.0.9 address-family ipv4-unicast route-map import FROM-PROVIDER
set protocols bgp neighbor 198.18.0.9 address-family ipv4-unicast route-map export TO-UPSTREAM
