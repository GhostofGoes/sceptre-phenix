# Repositories and refs the E2E workflow uses for the apps and image recipes
# when it runs in this repository (pushes, pull requests, schedules). When
# another repository calls the workflow, its inputs override these.
APPS_REPOSITORY=GhostofGoes/sceptre-phenix-apps
APPS_REF=ci-e2e-minimega
IMAGES_REPOSITORY=GhostofGoes/sceptre-phenix-images
IMAGES_REF=ci-e2e-minimega
