+	if got, err := vm.Info("pid"); err != nil || got == "0" {
+		t.Fatalf("Info(pid) = %q, %v; want non-zero", got, err)
+	}
+
+	stats, err := vm.ProcStats()
+	if err != nil {
+		t.Fatalf("ProcStats: %v", err)
+	}
+	if _, ok := stats[pid]; !ok {
+		t.Fatalf("ProcStats = %v, want entry for %d", stats, pid)
+	}
+
+	if _, err := os.Stat(filepath.Join(vm.GetInstancePath(), "stub.log")); err != nil {
+		t.Fatalf("stub.log: %v", err)
