+
+	if err := vm.Start(); err != nil {
+		t.Fatalf("Start from paused: %v", err)
+	}
+	expectState(t, vm, VM_RUNNING)
+
+	if err := syscall.Kill(pid, 0); err != nil {
+		t.Fatalf("stand-in process %d is gone before kill: %v", pid, err)
+	}
+
+	if err := vm.Kill(); err != nil {
+		t.Fatalf("Kill: %v", err)
+	}
+	expectState(t, vm, VM_QUIT)
+
+	if err := syscall.Kill(pid, 0); err != syscall.ESRCH {
+		t.Fatalf("stand-in process %d still exists after kill: %v", pid, err)
+	}
+
+	stats, err = vm.ProcStats()
