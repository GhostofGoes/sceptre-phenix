@@ -0,0 +1,530 @@
+// Copyright 2026 National Technology & Engineering Solutions of Sandia, LLC (NTESS).
+// Under the terms of Contract DE-NA0003525 with NTESS, the U.S. Government retains certain
+// rights in this software.
+
+// Stub VMs are an experimental VM type for end-to-end testing of minimega and
+// of orchestrators that drive it, such as phenix, on hosts where QEMU/KVM and
+// containers are unavailable or too slow. A stub VM takes part in the normal
+// VM lifecycle and state machine, creates real taps on the configured bridges,
+// shows up in `vm info`, carries tags, and offers the miniccc backchannel over
+// a unix socket in its instance directory, but runs no hypervisor and no
+// container.
+//
+// Stub VMs deliberately reuse ContainerConfig so that no vmconfiger
+// regeneration is needed:
+//
+//   - `vm config init <cmd...>` optionally names a host process that is
+//     started as a stand-in "guest" when the VM starts, for example a wrapper
+//     around the real miniccc binary. The process runs in the instance
+//     directory and receives the MM_STUB_* environment variables documented
+//     on StubVM.Start. The container default, "/init", means no stand-in.
+//   - `vm config hostname` is informational only.
+//   - `vm config filesystem` is not required and is ignored, as are
+//     `preinit`, `fifos`, and `volume`.
+
+package main
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"image"
+	"image/color"
+	"image/draw"
+	"image/png"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"syscall"
+
+	"github.com/sandia-minimega/minimega/v2/internal/bridge"
+	"github.com/sandia-minimega/minimega/v2/internal/ron"
+	log "github.com/sandia-minimega/minimega/v2/pkg/minilog"
+)
+
+// containerDefaultInit is the default of `vm config init` (see
+// ContainerConfig.Init), which stubs treat as "no stand-in process".
+const containerDefaultInit = "/init"
+
+type StubVM struct {
+	*BaseVM         // embed
+	ContainerConfig // embed
+
+	// proc is the running stand-in process, if any. Guarded by lock.
+	proc *os.Process
+
+	// started hands the stand-in process to the lifecycle goroutine spawned
+	// at launch. Replaced on every (re)launch. Guarded by lock.
+	started chan *os.Process
+}
+
+// Ensure that StubVM implements the VM interface
+var _ VM = (*StubVM)(nil)
+
+func NewStub(name, namespace string, config VMConfig) (*StubVM, error) {
+	vm := new(StubVM)
+
+	vm.BaseVM = NewBaseVM(name, namespace, config)
+	vm.Type = STUB
+
+	vm.ContainerConfig = config.ContainerConfig.Copy() // deep-copy configured fields
+
+	// set hostname to VM's name if it's unspecified. note that the name arg
+	// may be the empty string but NewBaseVM populates vm.Name with a default
+	// value if that's the case.
+	if vm.Hostname == "" {
+		vm.Hostname = vm.Name
+	}
+
+	return vm, nil
+}
+
+func (vm *StubVM) Config() *BaseConfig {
+	return &vm.BaseConfig
+}
+
+func (vm *StubVM) Copy() VM {
+	vm.lock.Lock()
+	defer vm.lock.Unlock()
+
+	vm2 := new(StubVM)
+
+	// Make shallow copies of all fields
+	*vm2 = *vm
+
+	// Make deep copies
+	vm2.BaseVM = vm.BaseVM.copy()
+	vm2.ContainerConfig = vm.ContainerConfig.Copy()
+
+	// Copies are read-only and must not share lifecycle handles
+	vm2.proc = nil
+	vm2.started = nil
+
+	return vm2
+}
+
+// Launch a new stub VM. The VM is returned pre-locked by NewBaseVM.
+func (vm *StubVM) Launch() error {
+	defer vm.lock.Unlock()
+
+	return vm.launch()
+}
+
+// Recover an existing stub VM. This resets the ID and PID for the VM and
+// unlocks the VM (since VMs come pre-locked when created via NewBaseVM).
+func (vm *StubVM) Recover(id string, pid int) error {
+	vm.ID, _ = strconv.Atoi(id)
+	vm.Pid = pid
+	vm.instancePath = filepath.Join(*f_base, id)
+
+	vm.lock.Unlock()
+	return nil
+}
+
+// launch is the low-level launch function for stub VMs. The caller should
+// hold the VM's lock. It is safe to call again when relaunching a VM from the
+// QUIT or ERROR state.
+func (vm *StubVM) launch() error {
+	log.Info("launching vm: %v", vm.ID)
+
+	// If this is the first time launching the VM, create directories for it.
+	if vm.State == VM_BUILDING {
+		if err := os.MkdirAll(vm.instancePath, os.FileMode(0700)); err != nil {
+			return vm.setErrorf("unable to create VM dir: %v", err)
+		}
+
+		if err := vm.createInstancePathAlias(); err != nil {
+			return vm.setErrorf("createInstancePathAlias: %v", err)
+		}
+	}
+
+	mustWrite(vm.path("name"), vm.Name)
+
+	if err := vm.createTaps(); err != nil {
+		return err
+	}
+
+	// The lifecycle goroutine is started at launch, not at start, so that a
+	// stub that is still BUILDING can be killed.
+	vm.started = make(chan *os.Process, 1)
+	go vm.lifecycle(vm.kill, vm.started)
+
+	return nil
+}
+
+// createTaps does the work of adding any taps if we are associated with any
+// networks. It mirrors KvmVM.createTaps: stubs own their taps from launch
+// until flush, so taps that already exist are left alone on relaunch.
+func (vm *StubVM) createTaps() error {
+	for i := range vm.Networks {
+		nic := &vm.Networks[i]
+		if nic.Tap != "" {
+			// tap has already been created, don't need to do again
+			continue
+		}
+
+		br, err := getBridge(nic.Bridge)
+		if err != nil {
+			return vm.setErrorf("unable to get bridge %v: %v", nic.Bridge, err)
+		}
+
+		tap, err := br.CreateTap("", nic.MAC, nic.VLAN)
+		if err != nil {
+			return vm.setErrorf("unable to create tap %v: %v", i, err)
+		}
+
+		nic.Tap = tap
+
+		if nic.QinQ {
+			if err := br.SetTapQinQ(tap, nic.VLAN); err != nil {
+				return vm.setErrorf("unable to set QinQ on tap %v: %v", i, err)
+			}
+		}
+	}
+
+	if len(vm.Networks) > 0 {
+		if err := vm.writeTaps(); err != nil {
+			return vm.setErrorf("unable to write taps: %v", err)
+		}
+	}
+
+	return nil
+}
+
+// lifecycle moves the VM to QUIT once it is killed or once its stand-in
+// process exits. It is bound to the kill channel of one launch; Start hands
+// over the stand-in process, if any, through started.
+func (vm *StubVM) lifecycle(kill chan bool, started chan *os.Process) {
+	var p *os.Process
+
+	// closed once the stand-in process has been reaped
+	exited := make(chan struct{})
+
+	select {
+	case p = <-started:
+		go func() {
+			defer close(exited)
+
+			if _, err := p.Wait(); err != nil {
+				log.Debug("vm %v: stand-in process: %v", vm.ID, err)
+			}
+		}()
+
+		select {
+		case <-exited:
+			log.Info("vm %v: stand-in process exited", vm.ID)
+		case <-kill:
+			log.Info("killing VM %v", vm.ID)
+
+			// Kill the whole process group so that children of a wrapper
+			// script die along with it.
+			if err := syscall.Kill(-p.Pid, syscall.SIGKILL); err != nil {
+				log.Error("vm %v: unable to kill process group %v: %v", vm.ID, p.Pid, err)
+				p.Kill()
+			}
+
+			<-exited
+		}
+	case <-kill:
+		log.Info("killing VM %v", vm.ID)
+	}
+
+	vm.lock.Lock()
+	defer vm.lock.Unlock()
+
+	// A relaunch replaces the kill channel, so only the lifecycle goroutine of
+	// the current launch may update the VM.
+	if vm.kill != kill {
+		return
+	}
+
+	vm.proc = nil
+
+	// Set to QUIT unless we've already been put into the error state
+	if vm.State&VM_KILLABLE != 0 {
+		vm.setState(VM_QUIT)
+	}
+
+	vm.cond.Broadcast()
+}
+
+// closeKill closes the kill channel unless it is already closed, which ends
+// the lifecycle goroutine of the current launch. Nothing ever sends on the
+// kill channel, so the check is race-free. The caller must hold the VM lock.
+func (vm *StubVM) closeKill() {
+	select {
+	case <-vm.kill:
+	default:
+		close(vm.kill)
+	}
+}
+
+// startProcess starts the stand-in process named by `vm config init`, if
+// any, and hands it to the lifecycle goroutine. The caller must hold the VM
+// lock.
+func (vm *StubVM) startProcess() error {
+	// ContainerConfig defaults Init to "/init", a path inside a container
+	// filesystem. A stub has no filesystem, so that default means "no
+	// stand-in process".
+	if len(vm.Init) == 0 || (len(vm.Init) == 1 && vm.Init[0] == containerDefaultInit) {
+		return nil
+	}
+
+	logFile, err := os.OpenFile(vm.path("stub.log"), os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)
+	if err != nil {
+		return fmt.Errorf("unable to create stub log: %v", err)
+	}
+	defer logFile.Close()
+
+	cmd := exec.Command(vm.Init[0], vm.Init[1:]...)
+	cmd.Dir = vm.instancePath
+	cmd.Stdout = logFile
+	cmd.Stderr = logFile
+	cmd.Env = append(os.Environ(),
+		"MM_STUB_NAME="+vm.Name,
+		"MM_STUB_UUID="+vm.UUID,
+		"MM_STUB_NAMESPACE="+vm.Namespace,
+		"MM_STUB_INSTANCE="+vm.instancePath,
+		"MM_STUB_CC="+vm.path("cc"),
+	)
+
+	// Run in a new process group so that stop, start, and kill reach a wrapper
+	// script and everything it starts.
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+
+	if err := cmd.Start(); err != nil {
+		return fmt.Errorf("unable to start %v: %v", vm.Init[0], err)
+	}
+
+	vm.proc = cmd.Process
+	vm.Pid = cmd.Process.Pid
+	log.Debug("vm %v has pid %v", vm.ID, vm.Pid)
+
+	vm.started <- cmd.Process
+
+	return nil
+}
+
+// Start a stub VM. On the first start, or after QUIT or ERROR, the stand-in
+// process named by `vm config init` (if any) is started in the instance
+// directory with these environment variables in addition to minimega's own:
+//
+//	MM_STUB_NAME      the VM name
+//	MM_STUB_UUID      the VM UUID, to pass to miniccc as -uuid
+//	MM_STUB_NAMESPACE the VM's namespace
+//	MM_STUB_INSTANCE  the instance directory
+//	MM_STUB_CC        the cc unix socket, to pass to miniccc as -parent
+//
+// The cc socket is created by Connect after Start returns, so a stand-in that
+// dials MM_STUB_CC must wait for it to appear. Starting a PAUSED VM resumes
+// the stand-in process instead.
+func (vm *StubVM) Start() (err error) {
+	vm.lock.Lock()
+	defer vm.lock.Unlock()
+
+	if vm.State&VM_RUNNING != 0 {
+		return nil
+	}
+
+	if vm.State == VM_QUIT || vm.State == VM_ERROR {
+		log.Info("relaunching VM: %v", vm.ID)
+
+		// End the previous lifecycle goroutine, which may still be waiting if
+		// the previous start failed, before creating the channel for the new
+		// launch.
+		vm.closeKill()
+		vm.kill = make(chan bool)
+
+		// Launch handles setting the VM to error state
+		if err := vm.launch(); err != nil {
+			return err
+		}
+	}
+
+	log.Info("starting VM: %v", vm.ID)
+
+	if vm.State == VM_PAUSED {
+		if vm.proc != nil {
+			if err := syscall.Kill(-vm.proc.Pid, syscall.SIGCONT); err != nil {
+				return vm.setErrorf("unable to resume: %v", err)
+			}
+		}
+	} else if err := vm.startProcess(); err != nil {
+		return vm.setErrorf("unable to start: %v", err)
+	}
+
+	vm.setState(VM_RUNNING)
+
+	return nil
+}
+
+func (vm *StubVM) Stop() error {
+	vm.lock.Lock()
+	defer vm.lock.Unlock()
+
+	if vm.State != VM_RUNNING {
+		return vmNotRunning(strconv.Itoa(vm.ID))
+	}
+
+	log.Info("stopping VM: %v", vm.ID)
+
+	if vm.proc != nil {
+		if err := syscall.Kill(-vm.proc.Pid, syscall.SIGSTOP); err != nil {
+			return vm.setErrorf("unstoppable: %v", err)
+		}
+	}
+
+	vm.setState(VM_PAUSED)
+
+	return nil
+}
+
+// Flush cleans up all resources allocated to the VM which includes all the
+// network taps.
+func (vm *StubVM) Flush() error {
+	vm.lock.Lock()
+	defer vm.lock.Unlock()
+
+	// Make sure no lifecycle goroutine outlives the VM, e.g. after a failed
+	// start left the VM in the error state.
+	vm.closeKill()
+
+	for _, net := range vm.Networks {
+		// Stub VMs can enter ERROR before all taps are created.
+		if net.Tap == "" {
+			continue
+		}
+
+		// Handle already disconnected taps differently since they aren't
+		// assigned to any bridges.
+		if net.VLAN == DisconnectedVLAN {
+			if err := bridge.DestroyTap(net.Tap); err != nil {
+				log.Error("leaked tap %v: %v", net.Tap, err)
+			}
+
+			continue
+		}
+
+		br, err := getBridge(net.Bridge)
+		if err != nil {
+			return err
+		}
+
+		if err := br.DestroyTap(net.Tap); err != nil {
+			log.Error("leaked tap %v: %v", net.Tap, err)
+		}
+	}
+
+	return vm.BaseVM.Flush()
+}
+
+func (vm *StubVM) String() string {
+	return fmt.Sprintf("%s:%d:stub", hostname, vm.ID)
+}
+
+func (vm *StubVM) Info(field string) (string, error) {
+	// If the field is handled by BaseVM, return it
+	if v, err := vm.BaseVM.Info(field); err == nil {
+		return v, nil
+	}
+
+	vm.lock.Lock()
+	defer vm.lock.Unlock()
+
+	return vm.ContainerConfig.Info(field)
+}
+
+func (vm *StubVM) Conflicts(vm2 VM) error {
+	switch vm2 := vm2.(type) {
+	case *StubVM:
+		return vm.conflictsBase(vm2.BaseVM)
+	case *KvmVM:
+		return vm.conflictsBase(vm2.BaseVM)
+	case *ContainerVM:
+		return vm.conflictsBase(vm2.BaseVM)
+	case *AndroidVM:
+		return vm.conflictsBase(vm2.BaseVM)
+	}
+
+	return errors.New("unknown VM type")
+}
+
+// conflictsBase checks whether the BaseVMs conflict. Only the receiver is
+// locked: vm2 is a newly created VM that is still locked by NewBaseVM.
+func (vm *StubVM) conflictsBase(vm2 *BaseVM) error {
+	vm.lock.Lock()
+	defer vm.lock.Unlock()
+
+	return vm.BaseVM.conflicts(vm2)
+}
+
+// Screenshot returns a solid-colour PNG so that tools which fetch screenshots
+// of every VM receive a valid image.
+func (vm *StubVM) Screenshot(size int) ([]byte, error) {
+	width, height := 64, 48
+	if size > 0 {
+		width, height = size, size*3/4
+		if height < 1 {
+			height = 1
+		}
+	}
+
+	img := image.NewRGBA(image.Rect(0, 0, width, height))
+	draw.Draw(img, img.Bounds(), image.NewUniform(color.RGBA{R: 0x3b, G: 0x4a, B: 0x5a, A: 0xff}), image.Point{}, draw.Src)
+
+	var buf bytes.Buffer
+	if err := png.Encode(&buf, img); err != nil {
+		return nil, err
+	}
+
+	return buf.Bytes(), nil
+}
+
+func (vm *StubVM) Connect(cc *ron.Server, reconnect bool) error {
+	if !vm.Backchannel || reconnect {
+		return nil
+	}
+
+	cc.RegisterVM(vm)
+
+	return cc.ListenUnix(vm.path("cc"))
+}
+
+func (vm *StubVM) Disconnect(cc *ron.Server) error {
+	if !vm.Backchannel {
+		return nil
+	}
+
+	cc.UnregisterVM(vm)
+
+	return cc.CloseUnix(vm.path("cc"))
+}
+
+// ProcStats reports the stand-in process while it is running. A stub without
+// a stand-in process has no processes to report.
+func (vm *StubVM) ProcStats() (map[int]*ProcStats, error) {
+	vm.lock.Lock()
+	proc := vm.proc
+	vm.lock.Unlock()
+
+	if proc == nil {
+		return map[int]*ProcStats{}, nil
+	}
+
+	p, err := GetProcStats(proc.Pid)
+	if err != nil {
+		return nil, err
+	}
+
+	return map[int]*ProcStats{proc.Pid: p}, nil
+}
+
+func (vm *StubVM) WriteConfig(w io.Writer) error {
+	if err := vm.BaseConfig.WriteConfig(w); err != nil {
+		return err
+	}
+
+	return vm.ContainerConfig.WriteConfig(w)
+}
