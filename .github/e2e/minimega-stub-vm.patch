+// newTestStub points the base directory at a temporary directory, creates a
+// stub VM with the given init command, and launches it. Launch unlocks the VM.
+func newTestStub(t *testing.T, name string, init ...string) *StubVM {
+	t.Helper()
+
+	originalBase := *f_base
+	*f_base = t.TempDir()
+	t.Cleanup(func() { *f_base = originalBase })
+
+	cfg := NewVMConfig()
+	cfg.ContainerConfig.Init = init
+
+	vm, err := NewStub(name, DefaultNamespace, cfg)
+	if err != nil {
+		t.Fatalf("NewStub: %v", err)
+	}
+
+	if err := vm.Launch(); err != nil {
+		t.Fatalf("Launch: %v", err)
+	}
+
+	return vm
+}
+
+func expectState(t *testing.T, vm VM, want VMState) {
+	t.Helper()
+
+	if got := vm.GetState(); got != want {
+		t.Fatalf("state = %v, want %v", got, want)
+	}
+}
+
+// waitForState polls until the VM reaches want or the deadline passes.
+func waitForState(t *testing.T, vm VM, want VMState) {
+	t.Helper()
+
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if vm.GetState() == want {
+			return
+		}
+
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	t.Fatalf("state = %v after timeout, want %v", vm.GetState(), want)
+}
